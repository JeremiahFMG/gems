<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Fractal Organisational Dynamics</title>
<style>
  :root{
    --c-direction:#007028;
    --c-flow:#49c442;
    --c-sensing:#85ce84;
    --c-execution:#f4b400;
    --c-energy:#a6d66c;
    --c-regulation:#536e48;
    --c-core:#cccccc;
    --bg:#f6f8f6;
    --panel:#ffffff;
    --ink:#23302a;
    --muted:#6d7a72;
    --line:#e2e8e2;
  }
  *{box-sizing:border-box;}
  html,body{height:100%;margin:0;}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    background:var(--bg);
    color:var(--ink);
    overflow:hidden;
  }
  #app{display:flex;height:100vh;width:100vw;}

  /* ---------- Toolbar ---------- */
  #stage{position:relative;flex:1 1 auto;min-width:0;display:flex;flex-direction:column;}
  header{
    display:flex;align-items:center;gap:14px;flex-wrap:wrap;
    padding:10px 16px;border-bottom:1px solid var(--line);
    background:rgba(255,255,255,.7);backdrop-filter:blur(6px);z-index:5;
  }
  header h1{font-size:15px;margin:0;font-weight:650;letter-spacing:.2px;}
  header h1 span{color:var(--muted);font-weight:400;font-size:12px;margin-left:6px;}
  .toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-left:auto;}
  .toggle{
    display:inline-flex;align-items:center;gap:7px;cursor:pointer;
    font-size:12px;padding:6px 11px;border-radius:20px;border:1px solid var(--line);
    background:#fff;user-select:none;transition:.15s;white-space:nowrap;
  }
  .toggle:hover{border-color:#bcd1bc;}
  .toggle input{display:none;}
  .toggle .dot{width:10px;height:10px;border-radius:50%;background:#d4dcd4;transition:.15s;}
  .toggle.on{background:#eef6ee;border-color:#9fce9f;color:#13502a;font-weight:600;}
  .toggle.on .dot{background:var(--c-direction);}
  .seg{display:flex;border:1px solid var(--line);border-radius:20px;overflow:hidden;background:#fff;}
  .seg button{border:0;background:transparent;padding:6px 12px;font-size:12px;cursor:pointer;color:var(--muted);}
  .seg button.active{background:var(--c-direction);color:#fff;font-weight:600;}
  .btn{
    border:1px solid var(--line);background:#fff;border-radius:8px;padding:6px 10px;
    font-size:12px;cursor:pointer;color:var(--ink);transition:.15s;
  }
  .btn:hover{border-color:#bcd1bc;background:#f3f8f3;}
  .zoomctl{position:absolute;left:14px;bottom:14px;display:flex;flex-direction:column;gap:6px;z-index:5;}
  .zoomctl button{width:34px;height:34px;border-radius:9px;border:1px solid var(--line);background:#fff;font-size:16px;cursor:pointer;color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.06);}
  .zoomctl button:hover{background:#f1f7f1;}
  .levelnav{position:absolute;right:14px;bottom:14px;display:flex;gap:6px;z-index:5;}
  .levelnav button{border:1px solid var(--line);background:#fff;border-radius:8px;padding:6px 10px;font-size:11px;cursor:pointer;box-shadow:0 1px 3px rgba(0,0,0,.05);}
  .levelnav button:hover{background:#f1f7f1;}

  /* ---------- Canvas ---------- */
  #canvasWrap{flex:1 1 auto;position:relative;overflow:hidden;}
  svg#scene{width:100%;height:100%;display:block;cursor:grab;}
  svg#scene.dragging{cursor:grabbing;}

  .hex{cursor:pointer;transition:opacity .25s, transform .15s, filter .2s;}
  .hex polygon{transition:fill .25s, stroke .2s, stroke-width .2s, opacity .25s;stroke:#ffffff;stroke-width:1.5;}
  .hex text{pointer-events:none;font-size:9.5px;font-weight:600;fill:#143018;text-anchor:middle;}
  .hex .lvl{font-size:7.5px;font-weight:500;fill:rgba(20,48,24,.6);}
  .core polygon{stroke:#fff;stroke-width:1.5;}
  .core text{fill:#3a3f3a;font-weight:700;font-size:10px;}

  /* dim non-matching on hover/select */
  #scene.focusing .hex:not(.match){opacity:.18;}
  #scene.focusing .core{opacity:.3;}
  .hex.match polygon{stroke:#143018;stroke-width:2.4;}
  .hex.selected polygon{stroke:#0a1f0e;stroke-width:3;}

  /* diagnostic states */
  .hex.state-weak polygon{opacity:.55;}
  .hex.state-broken polygon{fill:#c9cfc9 !important;opacity:.85;}
  .hex.state-broken text{fill:#7c847c;}
  .ripple polygon{stroke:#e4572e !important;stroke-width:3 !important;animation:pulse 1.1s ease-in-out infinite;}
  @keyframes pulse{0%,100%{stroke-opacity:.35;}50%{stroke-opacity:1;}}

  .clusterLabel{font-size:13px;font-weight:700;fill:#2b3a30;text-anchor:middle;letter-spacing:.4px;}
  .clusterSub{font-size:9px;fill:var(--muted);text-anchor:middle;}

  .loopRing{fill:none;stroke:#9bbf9b;stroke-width:1.2;stroke-dasharray:3 7;opacity:.45;}
  #scene.flow .loopRing{animation:spin 9s linear infinite;transform-box:fill-box;transform-origin:center;}
  @keyframes spin{to{stroke-dashoffset:-200;}}

  .rel{opacity:0;transition:opacity .3s;}
  #scene.showrel .rel{opacity:1;}
  .rel.constraint{stroke:#536e48;stroke-width:2;fill:none;}
  .rel.feedback{stroke:#49c442;stroke-width:2;fill:none;stroke-dasharray:5 4;}
  #scene.flow .rel.feedback{animation:flowup 1.2s linear infinite;}
  @keyframes flowup{to{stroke-dashoffset:-18;}}
  .rel.coord{stroke:#bcd1bc;stroke-width:1.4;fill:none;}
  .relLabel{font-size:8px;fill:var(--muted);}

  /* ---------- Tooltip ---------- */
  #tip{
    position:fixed;pointer-events:none;z-index:50;max-width:230px;
    background:#15241a;color:#eaf3ea;padding:9px 11px;border-radius:9px;
    font-size:11.5px;line-height:1.4;box-shadow:0 6px 22px rgba(0,0,0,.25);
    opacity:0;transform:translateY(4px);transition:opacity .12s, transform .12s;
  }
  #tip.show{opacity:1;transform:translateY(0);}
  #tip b{display:block;font-size:12.5px;margin-bottom:2px;}
  #tip .fn{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px;vertical-align:middle;}
  #tip .lv{color:#a9c6ad;font-size:10.5px;margin-top:5px;}

  /* ---------- Side panel ---------- */
  #panel{
    width:0;flex:0 0 auto;background:var(--panel);border-left:1px solid var(--line);
    overflow:hidden;transition:width .28s cubic-bezier(.4,0,.2,1);
  }
  #panel.open{width:360px;}
  .panelInner{width:360px;height:100%;overflow-y:auto;padding:22px 22px 40px;}
  .panelHead{display:flex;align-items:center;gap:10px;}
  .panelHead .swatch{width:26px;height:26px;border-radius:7px;flex:0 0 auto;box-shadow:inset 0 0 0 2px rgba(255,255,255,.5);}
  .panelHead h2{margin:0;font-size:19px;}
  .closeX{margin-left:auto;border:0;background:#f0f3f0;width:28px;height:28px;border-radius:7px;cursor:pointer;font-size:15px;color:#566;}
  .closeX:hover{background:#e6ece6;}
  .desc{color:#3c473f;font-size:13.5px;line-height:1.5;margin:14px 0 18px;}
  .sect{margin-bottom:18px;}
  .sect h3{font-size:11px;text-transform:uppercase;letter-spacing:.7px;color:var(--muted);margin:0 0 9px;}
  .lvlrow{display:flex;gap:10px;align-items:baseline;padding:8px 10px;border-radius:8px;background:#f7faf7;margin-bottom:6px;}
  .lvlrow .tag{font-size:9.5px;font-weight:700;color:#fff;padding:2px 7px;border-radius:11px;flex:0 0 auto;}
  .lvlrow .v{font-size:13px;font-weight:600;}
  .lvlrow .x{font-size:11px;color:var(--muted);margin-left:auto;}
  .fail{display:flex;gap:8px;font-size:12.5px;line-height:1.45;padding:9px 11px;border-radius:8px;background:#fff6f3;border:1px solid #ffe1d7;margin-bottom:7px;color:#7a3a28;}
  .fail .arr{color:#e4572e;font-weight:700;}
  .loopnote{font-size:12px;color:#3c473f;line-height:1.5;background:#f3f8f3;border-radius:8px;padding:11px 12px;}
  .loopnote code{background:#e4efe4;padding:1px 5px;border-radius:4px;font-size:11px;}

  /* legend */
  #legend{position:absolute;left:14px;top:12px;background:rgba(255,255,255,.85);border:1px solid var(--line);border-radius:10px;padding:9px 11px;font-size:10.5px;z-index:4;box-shadow:0 2px 8px rgba(0,0,0,.05);}
  #legend .t{font-weight:700;margin-bottom:6px;font-size:10px;letter-spacing:.4px;color:var(--muted);text-transform:uppercase;}
  #legend .row{display:flex;align-items:center;gap:6px;margin:3px 0;cursor:pointer;border-radius:5px;padding:1px 3px;}
  #legend .row:hover{background:#eef4ee;}
  #legend .row .c{width:11px;height:11px;border-radius:3px;}
  .hint{position:absolute;left:50%;transform:translateX(-50%);bottom:14px;font-size:11px;color:var(--muted);background:rgba(255,255,255,.8);padding:5px 12px;border-radius:14px;border:1px solid var(--line);z-index:4;}
  #diagHint{display:none;}
  #scene.diag ~ .hint #structHint{display:none;}
  .diagOn #diagHint{display:inline;}
  .diagOn #structHint{display:none;}

  /* states bar */
  #statesBar{display:flex;gap:6px;align-items:center;}
  #statesBar select{font-size:12px;padding:5px 7px;border-radius:8px;border:1px solid var(--line);background:#fff;max-width:130px;}
</style>
</head>
<body>
<div id="app">
  <div id="stage">
    <header>
      <h1>Fractal Organisational Dynamics <span>nested hexagonal systems</span></h1>
      <div class="toolbar">
        <label class="toggle" id="tg-rel"><span class="dot"></span><input type="checkbox" id="cb-rel">Show Relationships</label>
        <label class="toggle" id="tg-diag"><span class="dot"></span><input type="checkbox" id="cb-diag">Diagnostic Mode</label>
        <div class="seg" id="viewSeg">
          <button data-view="structural" class="active">Structural</button>
          <button data-view="flow">Flow</button>
        </div>
        <div id="statesBar">
          <button class="btn" id="saveBtn">Save</button>
          <select id="statesSel"><option value="">Load state…</option></select>
          <button class="btn" id="delBtn" title="Delete selected state">✕</button>
          <button class="btn" id="resetBtn" title="Reset diagnostics">Reset</button>
        </div>
      </div>
    </header>

    <div id="canvasWrap">
      <div id="legend">
        <div class="t">Function · colour</div>
        <div class="row" data-fn="direction"><span class="c" style="background:#007028"></span>Direction</div>
        <div class="row" data-fn="sensing"><span class="c" style="background:#85ce84"></span>Sensing</div>
        <div class="row" data-fn="flow"><span class="c" style="background:#49c442"></span>Flow</div>
        <div class="row" data-fn="execution"><span class="c" style="background:#f4b400"></span>Execution</div>
        <div class="row" data-fn="energy"><span class="c" style="background:#a6d66c"></span>Energy</div>
        <div class="row" data-fn="regulation"><span class="c" style="background:#536e48"></span>Regulation</div>
      </div>

      <svg id="scene" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <marker id="arrowDown" markerWidth="9" markerHeight="9" refX="4.5" refY="7.5" orient="auto" markerUnits="userSpaceOnUse">
            <path d="M0,0 L4.5,7.5 L9,0" fill="none" stroke="#536e48" stroke-width="2"/>
          </marker>
          <marker id="arrowUp" markerWidth="9" markerHeight="9" refX="4.5" refY="1.5" orient="auto" markerUnits="userSpaceOnUse">
            <path d="M0,9 L4.5,1.5 L9,9" fill="none" stroke="#49c442" stroke-width="2"/>
          </marker>
          <filter id="softGlow" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="3" result="b"/>
            <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
        </defs>
        <g id="world"></g>
      </svg>

      <div class="zoomctl">
        <button id="zin">+</button>
        <button id="zout">−</button>
        <button id="zreset" style="font-size:11px">⊙</button>
      </div>
      <div class="levelnav">
        <button data-focus="all">All</button>
        <button data-focus="0">Org</button>
        <button data-focus="1">Team</button>
        <button data-focus="2">Dev</button>
      </div>
      <div class="hint">
        <span id="structHint">Hover to compare a function across levels · Click a node for details</span>
        <span id="diagHint">Diagnostic Mode: click a node to cycle Healthy → Weak → Broken and watch ripples</span>
      </div>
    </div>
  </div>

  <aside id="panel"><div class="panelInner" id="panelInner"></div></aside>
</div>

<div id="tip"></div>

<script>
/* ============================================================
   DATA MODEL
============================================================ */
const COLORS = {
  direction:'#007028', flow:'#49c442', sensing:'#85ce84',
  execution:'#f4b400', energy:'#a6d66c', regulation:'#536e48', core:'#cccccc'
};

const FUNCTIONS = {
  direction:{
    name:'Direction',
    desc:'Where the system is heading — goals, intent and prioritisation that give activity a purpose.',
    fail:['Weak Direction → drift, conflicting priorities, busy-but-aimless work','Broken Direction → effort scattered with no shared destination']
  },
  sensing:{
    name:'Sensing',
    desc:'How the system perceives itself and its environment — the signals it reads to stay aware.',
    fail:['Weak Sensing → blind spots, problems detected too late','Broken Sensing → decisions made on stale or missing information']
  },
  flow:{
    name:'Flow',
    desc:'How information and work move between components — the connective tissue of the system.',
    fail:['Weak Flow → silos, handoff friction, poor collaboration','Broken Flow → knowledge trapped, duplicated or lost work']
  },
  execution:{
    name:'Execution',
    desc:'How intent is converted into real output — the system turning plans into delivered work.',
    fail:['Weak Execution → missed delivery, low throughput','Broken Execution → plans never materialise into outcomes']
  },
  energy:{
    name:'Energy',
    desc:'The fuel that powers activity — capacity, funding and motivation sustaining the system.',
    fail:['Weak Energy → overload, stalled initiatives, fatigue','Broken Energy → burnout, attrition, collapse of momentum']
  },
  regulation:{
    name:'Regulation',
    desc:'How the system maintains stability, standards and balance — the guardrails that keep it coherent.',
    fail:['Weak Regulation → inconsistency, quality erosion','Broken Regulation → chaos, rework, loss of trust']
  }
};

// position key -> function key  (layout is identical at every level)
const SLOTS = {
  top:'direction', tl:'sensing', tr:'flow',
  bl:'energy', br:'execution', bottom:'regulation'
};

const LEVELS = [
  { key:'org',  label:'Organisation', sub:'system', core:'Organisation',
    labels:{ direction:'Strategy', sensing:'KPIs', flow:'Cross-Team Flow', execution:'Execution', energy:'Funding', regulation:'Governance' } },
  { key:'team', label:'Team', sub:'system', core:'Team',
    labels:{ direction:'Sprint Goals', sensing:'Metrics', flow:'Collaboration', execution:'Delivery', energy:'Capacity', regulation:'Standards' } },
  { key:'dev',  label:'Individual', sub:'developer', core:'Developer',
    labels:{ direction:'Personal Goals', sensing:'Self-Awareness', flow:'Communication', execution:'Coding', energy:'Energy', regulation:'Habits' } }
];

// system loop order: Direction → Execution → Sensing → Regulation → Flow → Energy → (Direction)
const LOOP = ['direction','execution','sensing','regulation','flow','energy'];
const nextInLoop = fn => LOOP[(LOOP.indexOf(fn)+1)%LOOP.length];

/* ============================================================
   GEOMETRY
============================================================ */
const SVGNS='http://www.w3.org/2000/svg';
const R = 112;          // ring radius (centre → surrounding node)
const HEXR = 45;        // node hexagon radius
const CX = 330;         // cluster centre x
const CY = [185, 510, 835];   // cluster centre y per level
const WORLD_W = 660, WORLD_H = 1020;

const SLOT_POS = {
  top:    {x:0,        y:-R},
  bottom: {x:0,        y:R},
  tl:     {x:-R*Math.cos(Math.PI/6), y:-R*Math.sin(Math.PI/6)},
  tr:     {x: R*Math.cos(Math.PI/6), y:-R*Math.sin(Math.PI/6)},
  bl:     {x:-R*Math.cos(Math.PI/6), y: R*Math.sin(Math.PI/6)},
  br:     {x: R*Math.cos(Math.PI/6), y: R*Math.sin(Math.PI/6)}
};

function hexPoints(cx,cy,r){
  let p=[];
  for(let i=0;i<6;i++){
    const a=Math.PI/180*(60*i-90); // pointy-top
    p.push((cx+r*Math.cos(a)).toFixed(2)+','+(cy+r*Math.sin(a)).toFixed(2));
  }
  return p.join(' ');
}
function el(tag,attrs){const e=document.createElementNS(SVGNS,tag);for(const k in attrs)e.setAttribute(k,attrs[k]);return e;}
function wrap(label){
  const words=label.split(' ');
  if(words.length===1) return [label];
  if(words.length===2) return words;
  return [words.slice(0,2).join(' '), words.slice(2).join(' ')];
}

/* ============================================================
   STATE
============================================================ */
const diag = {};   // `${levelKey}:${fn}` -> 'healthy'|'weak'|'broken'
let selectedFn = null;
let diagMode = false;

const scene = document.getElementById('scene');
const world = document.getElementById('world');
const nodeIndex = {};      // fn -> [hexGroup,...]
const coreCenters = [];    // per level {x,y}

/* ============================================================
   BUILD
============================================================ */
function build(){
  scene.setAttribute('viewBox',`0 0 ${WORLD_W} ${WORLD_H}`);

  LEVELS.forEach((lvl,li)=>{
    const cy = CY[li];
    coreCenters[li]={x:CX,y:cy};
    const g = el('g',{class:'cluster','data-level':li});

    // subtle system loop ring
    g.appendChild(el('circle',{class:'loopRing',cx:CX,cy:cy,r:R}));

    // cluster label (left of cluster)
    const lab = el('text',{class:'clusterLabel',x:CX-R-58,y:cy-6}); lab.textContent=lvl.label;
    const sub = el('text',{class:'clusterSub',x:CX-R-58,y:cy+9}); sub.textContent='“'+lvl.sub+'”';
    lab.setAttribute('text-anchor','middle'); sub.setAttribute('text-anchor','middle');
    g.appendChild(lab); g.appendChild(sub);

    // surrounding function nodes
    for(const slot in SLOTS){
      const fn = SLOTS[slot];
      const pos = SLOT_POS[slot];
      const x = CX+pos.x, y = cy+pos.y;
      const hg = el('g',{class:'hex','data-fn':fn,'data-level':li,'data-levelkey':lvl.key});
      hg.appendChild(el('polygon',{points:hexPoints(x,y,HEXR),fill:COLORS[fn]}));

      const lines = wrap(lvl.labels[fn]);
      const startY = y - (lines.length-1)*5.5 + 1;
      lines.forEach((ln,i)=>{
        const t=el('text',{x:x,y:(startY+i*11).toFixed(1)}); t.textContent=ln; hg.appendChild(t);
      });
      const fl=el('text',{class:'lvl',x:x,y:(y+HEXR-9).toFixed(1)}); fl.textContent=FUNCTIONS[fn].name; hg.appendChild(fl);

      g.appendChild(hg);
      (nodeIndex[fn]=nodeIndex[fn]||[]).push(hg);

      // events
      hg._meta={fn,li,slot,x,y};
      hg.addEventListener('mouseenter',onEnter);
      hg.addEventListener('mousemove',onMove);
      hg.addEventListener('mouseleave',onLeave);
      hg.addEventListener('click',onNodeClick);
    }

    // core node
    const cg = el('g',{class:'hex core','data-level':li});
    cg.appendChild(el('polygon',{points:hexPoints(CX,cy,HEXR*0.92),fill:COLORS.core}));
    const ct=el('text',{x:CX,y:cy-1}); ct.textContent=lvl.core; cg.appendChild(ct);
    const cs=el('text',{class:'lvl',x:CX,y:cy+11}); cs.textContent='core'; cg.appendChild(cs);
    g.appendChild(cg);

    world.appendChild(g);
  });

  buildRelationships();
}

/* relationship arrows (hidden until toggled) */
function buildRelationships(){
  const rg = el('g',{id:'rels'});
  // constraint (down, left side) + feedback (up, right side) between cores
  for(let i=0;i<coreCenters.length-1;i++){
    const a=coreCenters[i], b=coreCenters[i+1];
    const topY=a.y+HEXR*0.92, botY=b.y-HEXR*0.92;
    // constraint down (left offset)
    rg.appendChild(el('path',{class:'rel constraint',d:`M ${a.x-26} ${topY} L ${b.x-26} ${botY}`,'marker-end':'url(#arrowDown)'}));
    // feedback up (right offset)
    rg.appendChild(el('path',{class:'rel feedback',d:`M ${b.x+26} ${botY} L ${a.x+26} ${topY}`,'marker-end':'url(#arrowUp)'}));
  }
  // labels
  const midA=(coreCenters[0].y+coreCenters[1].y)/2;
  const cl=el('text',{class:'rel relLabel',x:CX-70,y:midA,'text-anchor':'end'}); cl.textContent='↓ constraint';
  const fl=el('text',{class:'rel relLabel',x:CX+70,y:midA,'text-anchor':'start'}); fl.textContent='feedback ↑';
  rg.appendChild(cl); rg.appendChild(fl);

  // coordination: faint ring per cluster emphasised
  coreCenters.forEach(c=>{
    rg.appendChild(el('circle',{class:'rel coord',cx:c.x,cy:c.y,r:R+2}));
  });
  const co=el('text',{class:'rel relLabel',x:CX+R+10,y:coreCenters[0].y,'text-anchor':'start'}); co.textContent='🔁 coordination';
  rg.appendChild(co);
  world.appendChild(rg);
}

/* ============================================================
   HOVER
============================================================ */
const tip=document.getElementById('tip');
function onEnter(e){
  const {fn,li}=this._meta;
  highlightFn(fn);
  const lvl=LEVELS[li];
  tip.innerHTML=`<b><span class="fn" style="background:${COLORS[fn]}"></span>${FUNCTIONS[fn].name}</b>${FUNCTIONS[fn].desc}<div class="lv">At ${lvl.label}: <b style="color:#dff0df">${lvl.labels[fn]}</b></div>`;
  tip.classList.add('show');
}
function onMove(e){ tip.style.left=(e.clientX+14)+'px'; tip.style.top=(e.clientY+14)+'px'; }
function onLeave(){ if(!selectedFn) clearHighlight(); tip.classList.remove('show'); }

function highlightFn(fn){
  scene.classList.add('focusing');
  document.querySelectorAll('.hex.match').forEach(n=>n.classList.remove('match'));
  (nodeIndex[fn]||[]).forEach(n=>n.classList.add('match'));
}
function clearHighlight(){
  scene.classList.remove('focusing');
  document.querySelectorAll('.hex.match').forEach(n=>n.classList.remove('match'));
}

/* legend hover */
document.querySelectorAll('#legend .row').forEach(r=>{
  r.addEventListener('mouseenter',()=>highlightFn(r.dataset.fn));
  r.addEventListener('mouseleave',()=>{ if(!selectedFn) clearHighlight(); });
  r.addEventListener('click',()=>openPanel(r.dataset.fn));
});

/* ============================================================
   CLICK
============================================================ */
function onNodeClick(e){
  e.stopPropagation();
  const {fn,li}=this._meta;
  if(diagMode){ cycleDiag(li,fn); return; }
  openPanel(fn);
}
scene.addEventListener('click',()=>{ if(!diagMode) closePanel(); });

/* ============================================================
   SIDE PANEL
============================================================ */
const panel=document.getElementById('panel');
const panelInner=document.getElementById('panelInner');
function openPanel(fn){
  selectedFn=fn;
  highlightFn(fn);
  document.querySelectorAll('.hex.selected').forEach(n=>n.classList.remove('selected'));
  (nodeIndex[fn]||[]).forEach(n=>n.classList.add('selected'));

  const F=FUNCTIONS[fn];
  const tagColors={org:'#007028',team:'#49c442',dev:'#536e48'};
  let rows=LEVELS.map(l=>`
    <div class="lvlrow">
      <span class="tag" style="background:${tagColors[l.key]}">${l.label}</span>
      <span class="v">${l.labels[fn]}</span>
    </div>`).join('');
  let fails=F.fail.map(f=>{
    const [a,b]=f.split('→');
    return `<div class="fail"><span class="arr">→</span><span><b>${a.trim()}</b> ${b?b.trim():''}</span></div>`;
  }).join('');
  const nxt=nextInLoop(fn);

  panelInner.innerHTML=`
    <div class="panelHead">
      <div class="swatch" style="background:${COLORS[fn]}"></div>
      <h2>${F.name}</h2>
      <button class="closeX" id="closeP">✕</button>
    </div>
    <p class="desc">${F.desc}</p>
    <div class="sect">
      <h3>How it appears at each level</h3>
      ${rows}
    </div>
    <div class="sect">
      <h3>Common failure patterns</h3>
      ${fails}
    </div>
    <div class="sect">
      <h3>Place in the system loop</h3>
      <div class="loopnote">In the internal cycle, <b>${F.name}</b> feeds <b>${FUNCTIONS[nxt].name}</b>.<br>
      <code>Direction → Execution → Sensing → Regulation → Flow → Energy →</code><br>
      A weakness here tends to surface next as a ${FUNCTIONS[nxt].name.toLowerCase()} problem, and echoes vertically across all three levels.</div>
    </div>`;
  document.getElementById('closeP').addEventListener('click',(e)=>{e.stopPropagation();closePanel();});
  panel.classList.add('open');
}
function closePanel(){
  panel.classList.remove('open');
  selectedFn=null;
  document.querySelectorAll('.hex.selected').forEach(n=>n.classList.remove('selected'));
  clearHighlight();
}

/* ============================================================
   DIAGNOSTIC MODE
============================================================ */
const cbDiag=document.getElementById('cb-diag');
cbDiag.addEventListener('change',()=>{
  diagMode=cbDiag.checked;
  document.getElementById('tg-diag').classList.toggle('on',diagMode);
  document.body.classList.toggle('diagOn',diagMode);
  if(diagMode) closePanel();
});
function cycleDiag(li,fn){
  const key=`${LEVELS[li].key}:${fn}`;
  const order=['healthy','weak','broken'];
  const cur=diag[key]||'healthy';
  const nx=order[(order.indexOf(cur)+1)%order.length];
  if(nx==='healthy') delete diag[key]; else diag[key]=nx;
  applyDiag();
}
function applyDiag(){
  // clear
  document.querySelectorAll('.hex').forEach(n=>{
    n.classList.remove('state-weak','state-broken','ripple');
  });
  // apply states
  for(const key in diag){
    const [lk,fn]=key.split(':');
    const li=LEVELS.findIndex(l=>l.key===lk);
    const node=(nodeIndex[fn]||[])[li];
    if(node) node.classList.add('state-'+diag[key]);
  }
  // ripple: same function vertically + dependent (next in loop) within cluster
  for(const key in diag){
    const [lk,fn]=key.split(':');
    if(diag[key]==='healthy') continue;
    const li=LEVELS.findIndex(l=>l.key===lk);
    // vertical same-function ripple (other levels)
    (nodeIndex[fn]||[]).forEach((n,i)=>{ if(i!==li) n.classList.add('ripple'); });
    // dependent function in same cluster
    const dep=nextInLoop(fn);
    const depNode=(nodeIndex[dep]||[])[li];
    if(depNode) depNode.classList.add('ripple');
  }
}
document.getElementById('resetBtn').addEventListener('click',()=>{
  for(const k in diag) delete diag[k];
  applyDiag();
});

/* ============================================================
   RELATIONSHIPS + VIEW + FLOW
============================================================ */
const cbRel=document.getElementById('cb-rel');
cbRel.addEventListener('change',()=>{
  scene.classList.toggle('showrel',cbRel.checked);
  document.getElementById('tg-rel').classList.toggle('on',cbRel.checked);
});
document.querySelectorAll('#viewSeg button').forEach(b=>{
  b.addEventListener('click',()=>{
    document.querySelectorAll('#viewSeg button').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    scene.classList.toggle('flow',b.dataset.view==='flow');
  });
});

/* ============================================================
   ZOOM / PAN / FRACTAL FOCUS
============================================================ */
let view={x:0,y:0,k:1};
function applyView(){ world.setAttribute('transform',`translate(${view.x},${view.y}) scale(${view.k})`); }
function clampK(k){ return Math.max(0.45,Math.min(3.2,k)); }

document.getElementById('zin').onclick=()=>zoomAt(WORLD_W/2,WORLD_H/2,1.25);
document.getElementById('zout').onclick=()=>zoomAt(WORLD_W/2,WORLD_H/2,0.8);
document.getElementById('zreset').onclick=()=>{ view={x:0,y:0,k:1}; applyView(); };

function svgPt(clientX,clientY){
  const r=scene.getBoundingClientRect();
  const sx=WORLD_W/r.width, sy=WORLD_H/r.height;
  return { x:(clientX-r.left)*sx, y:(clientY-r.top)*sy };
}
function zoomAt(px,py,factor){
  const nk=clampK(view.k*factor);
  const f=nk/view.k;
  view.x = px - (px-view.x)*f;
  view.y = py - (py-view.y)*f;
  view.k = nk; applyView();
}
scene.addEventListener('wheel',e=>{
  e.preventDefault();
  const p=svgPt(e.clientX,e.clientY);
  zoomAt(p.x,p.y, e.deltaY<0?1.12:0.9);
},{passive:false});

// drag to pan
let dragging=false,last=null;
scene.addEventListener('mousedown',e=>{
  if(e.target.closest('.hex')) return; // let node clicks work
  dragging=true;last={x:e.clientX,y:e.clientY};scene.classList.add('dragging');
});
window.addEventListener('mousemove',e=>{
  if(!dragging)return;
  const r=scene.getBoundingClientRect();
  view.x += (e.clientX-last.x)*(WORLD_W/r.width);
  view.y += (e.clientY-last.y)*(WORLD_H/r.height);
  last={x:e.clientX,y:e.clientY};applyView();
});
window.addEventListener('mouseup',()=>{dragging=false;scene.classList.remove('dragging');});

document.querySelectorAll('.levelnav button').forEach(b=>{
  b.addEventListener('click',()=>{
    const f=b.dataset.focus;
    if(f==='all'){ animateView({x:0,y:0,k:1}); return; }
    const li=+f, c=coreCenters[li];
    const k=1.7;
    animateView({ x:WORLD_W/2 - c.x*k, y:WORLD_H/2 - c.y*k, k });
  });
});
function animateView(target){
  const start={...view}, t0=performance.now(), dur=420;
  function step(now){
    const p=Math.min(1,(now-t0)/dur), e=p<.5?2*p*p:1-Math.pow(-2*p+2,2)/2;
    view.x=start.x+(target.x-start.x)*e;
    view.y=start.y+(target.y-start.y)*e;
    view.k=start.k+(target.k-start.k)*e;
    applyView();
    if(p<1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

/* ============================================================
   SAVE / LOAD STATES (localStorage)
============================================================ */
const LS_KEY='fractalOrgStates';
const statesSel=document.getElementById('statesSel');
function loadStateList(){
  let store={};
  try{ store=JSON.parse(localStorage.getItem(LS_KEY)||'{}'); }catch(e){}
  statesSel.innerHTML='<option value="">Load state…</option>';
  Object.keys(store).forEach(n=>{
    const o=document.createElement('option');o.value=n;o.textContent=n;statesSel.appendChild(o);
  });
  return store;
}
document.getElementById('saveBtn').addEventListener('click',()=>{
  const name=prompt('Name this system state:','State '+(Object.keys(loadStateList()).length+1));
  if(!name) return;
  const store=loadStateList();
  store[name]={
    diag:{...diag},
    rel:cbRel.checked,
    diagMode:diagMode,
    view:scene.classList.contains('flow')?'flow':'structural',
    cam:{...view}
  };
  localStorage.setItem(LS_KEY,JSON.stringify(store));
  loadStateList();
  statesSel.value=name;
});
statesSel.addEventListener('change',()=>{
  const name=statesSel.value; if(!name) return;
  const store=loadStateList();
  const s=store[name]; if(!s) return;
  // diagnostics
  for(const k in diag) delete diag[k];
  Object.assign(diag,s.diag||{});
  applyDiag();
  // relationships
  cbRel.checked=!!s.rel; scene.classList.toggle('showrel',cbRel.checked);
  document.getElementById('tg-rel').classList.toggle('on',cbRel.checked);
  // diag mode
  cbDiag.checked=!!s.diagMode; diagMode=cbDiag.checked;
  document.getElementById('tg-diag').classList.toggle('on',diagMode);
  document.body.classList.toggle('diagOn',diagMode);
  // view
  const flow=s.view==='flow';
  scene.classList.toggle('flow',flow);
  document.querySelectorAll('#viewSeg button').forEach(x=>x.classList.toggle('active',x.dataset.view===(flow?'flow':'structural')));
  // camera
  if(s.cam){ animateView(s.cam); }
});
document.getElementById('delBtn').addEventListener('click',()=>{
  const name=statesSel.value; if(!name) return;
  const store=loadStateList(); delete store[name];
  localStorage.setItem(LS_KEY,JSON.stringify(store));
  loadStateList();
});

/* ============================================================
   INIT
============================================================ */
build();
applyView();
loadStateList();
</script>
